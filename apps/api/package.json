{
  "name": "@inkflow/api",
  "version": "1.0.0",
  "private": true,
  "description": "Inkflow NestJS API: REST, WebSocket collaboration, persistence",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "nest build && node dist/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@inkflow/collaboration": "workspace:*",
    "@inkflow/config": "workspace:*",
    "@inkflow/database": "workspace:*",
    "@inkflow/diagram-engine": "workspace:*",
    "@inkflow/elements": "workspace:*",
    "@inkflow/scene": "workspace:*",
    "@inkflow/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-ws": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^7.0.9",
    "pino": "^10.0.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7"
  }
}
