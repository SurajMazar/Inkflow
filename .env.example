# ─── Inkflow configuration ────────────────────────────────────────────────────
# Copy to `.env` for local development. Values marked "dev-only" MUST be replaced in production.

NODE_ENV=development
PORT=4310
LOG_LEVEL=info
# Set to true when running behind a reverse proxy / load balancer (X-Forwarded-* headers).
TRUST_PROXY=false

# Public origin of the web app and the API as reachable from browsers.
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api

# ─── PostgreSQL (primary data store) ──────────────────────────────────────────
# Host ports of the compose services can be changed with INKFLOW_POSTGRES_PORT, INKFLOW_REDIS_PORT,
# INKFLOW_MINIO_PORT, INKFLOW_SMTP_PORT and INKFLOW_MAILPIT_UI_PORT.
DATABASE_URL=postgresql://inkflow:inkflow@localhost:5433/inkflow?schema=public
# Used by integration + E2E tests.
TEST_DATABASE_URL=postgresql://inkflow:inkflow@localhost:5433/inkflow_test?schema=public

# ─── Redis (presence, pub/sub across API instances, rate limiting) ────────────
REDIS_URL=redis://localhost:6379

# ─── Auth / sessions ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-please-change-0123456789abcdef
SESSION_SECRET=dev-only-session-secret-please-change-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
REQUIRE_EMAIL_VERIFICATION=true

# ─── S3-compatible object storage (MinIO locally) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=inkflow
S3_ACCESS_KEY=inkflow
S3_SECRET_KEY=inkflow-dev-secret
S3_FORCE_PATH_STYLE=true

# ─── Email (Mailpit locally: UI at http://localhost:8026) ─────────────────────
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Inkflow <no-reply@inkflow.local>

# ─── OAuth (optional; buttons appear only when configured) ────────────────────
# Callback URLs: ${PUBLIC_API_URL}/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Limits & housekeeping ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
AUTO_VERSION_EVERY_OPS=500
AUTO_VERSION_EVERY_MINUTES=15
TRASH_RETENTION_DAYS=30
